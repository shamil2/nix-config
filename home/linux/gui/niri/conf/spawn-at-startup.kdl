// Autostart applications for Niri session

spawn-at-startup "xwayland-satellite"
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "blueman-applet"
spawn-at-startup "wallpaper-rotator"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist-store-safe"
spawn-at-startup "wl-paste" "--primary" "--type" "text" "--watch" "cliphist-store-safe" "--primary"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
